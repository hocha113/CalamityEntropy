FlowingLight: {
	DisplayName: Flowing Light
	Tooltip:
		'''
		{$CommonItemTooltip.FlightAndSlowfall}
		Hold ↓ when flying to hover
		Hold ↓ to accelerate the descent
		Immunity to lava and fire, and negates fall damage
		Allows sprinting on water and ice, greatly increasing movement speed
		$"Reaching the pinnacle of perfection"
		'''
}

PhantomLightWing: {
	DisplayName: Phantom Light Wings
	Tooltip:
		'''
		{$CommonItemTooltip.FlightAndSlowfall}
		Leaving starlight trails during flight
		'''
}

RuneWing: {
	DisplayName: Soar Rune
	Tooltip:
		'''
		{$CommonItemTooltip.FlightAndSlowfall}
		Press [KEY] to perform a Soul Dash of 40 tiles toward the cursor, with a [CD] second cooldown
		You are invulnerable for the whole Soul Dash and pass through enemy projectiles and platforms
		'''
}

BigShotsWing: {
	DisplayName: Big Shot's Wings
	Tooltip:
		'''
		{$CommonItemTooltip.FlightAndSlowfall}
		-90% flight time if there're any boss
		"Now's your chance to be a..."
		Hold Shift and Right Click to toggle strings' transparency
		[TOGGLE]
		'''
	Visual0: Opaque
	Visual1: Translucent
	Visual2: Invisible
}

IceShardWing: {
	DisplayName: Ice Shard Wings
	Tooltip:
		'''
		{$CommonItemTooltip.FlightAndSlowfall}
		It actually uses magic to fly
		'''
}

TheRevelation: {
	DisplayName: The Revelation
	Tooltip:
		'''
		{$CommonItemTooltip.FlightAndSlowfall}
		Charging when using weapons,
		when it is fully charged, release the mouse button to release a holy beam
		deals 50 damage every 3 frames
		Regarded as wing
		hold [down] when flying to hover
		'Awaken your faith'
		'''
}

VoidElytra: {
	DisplayName: Void Elytra
	Tooltip:
		'''
		{$CommonItemTooltip.FlightAndSlowfall}
		Double tap any direction to dash, spending a little flight time each dash
		With too little flight time you can still dash, paying with life through Void Touch instead
		[c/356498:Dedicate life to the void and achieve breakthroughs in the limits]
		'''
}
