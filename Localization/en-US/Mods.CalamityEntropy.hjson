ModNameOverride: Call of Void

Items: {
	VoidBlade: {
		DisplayName: Void Blade
		Tooltip: Perform broad, fast slashes in quick succession that inflicts [cebuff:CalamityEntropy/VoidTouch]
	}

	PrisonOfPermafrost: {
		DisplayName: Prison of Permafrost
		Tooltip:
			'''
			Create a blizzard of frost and ice
			Hits inflict [cebuff:Frostburn] and grant the user [cebuff:CalamityEntropy/CosmicFreeze], increasing life regeneration and freezing nearby enemies
			Occasionally shoots large ice shards that inflict [cebuff:CalamityEntropy/MarkedforDeath]
			'''
	}

	Kinanition: {
		DisplayName: Kinanition
		Tooltip:
			'''
			[c/ce97fa:Launches a series of lightning arrows that convert into homing energy bolts on hit]
			[c/ce97fa:These arrows retain the original effect of your ammunition]
			[c/0078b9:Right Click to launch a homing thunderbolt that bursts into lightning on hit]
			'''
	}

	VoidRelics: {
		DisplayName: Void Relics
		Tooltip:
			'''
			Summon a [ceeffect/cruiser:Voidgaze Eye] and an array of [ceeffect/cruiser:Voidborn Runes] around yourself
			Runes automatically fire homing [ceeffect/cruiser:voisen bolts] at nearby enemies and also damage enemies they touch, inflicting [cebuff:CalamityEntropy/VoidTouch]
			Left Click while the eye and runes are summoned to gather runes in front of you and rapidly fire [ceeffect/cruiser:voisen bolts] toward the cursor
			Releasing Left Click or holding for over 6 seconds reverts runes to their passive state
			Runes can be gathered for concentrated fire on up to a 36 second cooldown time based on how long it was held for
			During cooldown, runes gain 15% increased attack speed
			There can only be one set of void relics at a time
			'''
	}

	AuricToilet: {
		DisplayName: Auric Toilet
		Tooltip:
			'''
			Yharim's favorite place of respite. Sitting on such a revered object would be an egregious offense to all of Terraria. Too bad there's nothing stopping you...
			'You've made it. Need you go any farther?'
			'''
	}

	LotteryBox: {
		DisplayName: Lottery Terminal
		Tooltip:
			'''
			Spawns a personal gambling terminal
			Hold a coin in your inventory and click on it for a chance to win!
			'You've tried your luck in much more fatal ways thus far, what's a few coins for a good time?'
			'''
	}

	ToyRock: {
		DisplayName: Toy Rock
		Tooltip:
			'''
			Summons Wyrm-chan
			"She's still young"
			'''
	}

	YharimsStimulants: {
		DisplayName: Yharim's Stimulants
		Tooltip:
			'''
			5% increased damage
			4% increased critical strike chance
			10% increased melee speed
			Increases the knockback of your minions
			12% increased acceleration
			30% increased movement speed
			Greatly increases the Luck of the user
			+8 defense
			Provides +1HP/s life regeneration
			3% decreased mining speed
			'''
	}

	VoidBottle: {
		DisplayName: Void Ampule
		Tooltip:
			'''
			Summons the Cruiser
			Not consumable
			'''
	}

	VoidMonument: {
		DisplayName: Void Monument
		Tooltip: ""
	}

	Lore: {
		CruiserLore: {
			DisplayName: Cruiser
			Tooltip: ""
			Lore: "{$loreCruiser}"
		}

		NihilityTwinLore: {
			DisplayName: Nihility Twin
			Tooltip: ""
			Lore: "{$loreNihTwin}"
		}

		ProphetLore: {
			DisplayName: Prophet
			Tooltip: ""
			Lore: "{$loreProphet}"
		}

		LuminarisLore: {
			DisplayName: Luminaris
			Tooltip: ""
			Lore: "{$loreLuminaris}"
		}

		LoreApsychos: {
			DisplayName: Apsychos
			Tooltip: ""
			Lore:
				'''
				This ancient abomination was one of the first attempts at sealing away a god.
				At first, they tried to seal its essence within the tectonic plates deep in the world.
				This triggered the agitation of a dormant creature within the deepest lava oceans of the Underworld,
				causing it to lash out in an attempt to resist the sudden surge of energy.
				Ultimately, the attempt only half-succeded, leaving the strange creature stuck in its harrowing state.
				About time someone freed it of man's error.
				'''
		}

		LoreAcropolis: {
			DisplayName: Acropolis Machines
			Lore:
				'''
				These machines were built by Azafure as armed guardians for the city,
				their special metal shells let them survive that battle.
				Though many years have passed, 
				they still execute the program set since creation: eliminate all uninvited visitors
				Time has dulled them, but with refined high-tech precision,
				they can still restart using ambient heat
				'''
			Tooltip: ""
		}
	}

	BrokenChainsaw: {
		DisplayName: Broken Chainsaw
		Tooltip: After a while this weapon overheats, disabling its use for a bit
	}

	MechanicalChainsaw: {
		DisplayName: Mechanical Chainsaw
		Tooltip: After a while this weapon overheats, disabling its use for a bit
	}

	EnslavedStar: {
		DisplayName: Enslaved Star
		Tooltip: Inflicts [cebuff:CalamityEntropy/Plague] and occasionally releases homing plague bees
	}

	Euangelion: {
		DisplayName: Euangelion
		Tooltip: Inflicts [cebuff:CalamityEntropy/Nightwither] and occasionally releases homing balls of light
	}

	Pioneer: {
		DisplayName: Pioneer
		Tooltip: Carves out rifts of void from the end of the chainsaw
	}

	GodsSnack: {
		DisplayName: Divine Delight
		Tooltip: Summons DoG-Chan
	}

	CruiserBag: {
		DisplayName: Treasure Bag (Cruiser)
		Tooltip: ""
	}

	CruiserRelic: {
		DisplayName: Cruiser Relic
		Tooltip: ""
	}

	DivineRemnants: {
		DisplayName: Divine Remnants
		Tooltip: Summons an astral friend to guide your way
	}

	BottleDarkMatter: {
		DisplayName: Contained Dark Matter
		Tooltip: Summons Ceaseless-Void-Chan
	}

	DivineIntervention: {
		DisplayName: Divine Intervention
		Tooltip:
			'''
			Sends out a divine shield that reflects projectiles
			You can send a shield out every 5 minutes
			'''
	}

	Godhead: {
		DisplayName: Godhead
		Tooltip: Projectiles are surrounded with a damaging aura that ignores i-frames and scales with the weapon's damage
	}

	VoidEcho: {
		DisplayName: Symbol of Theocracy
		Tooltip:
			'''
			Summons a circle of up to 6 [ceeffect/cruiser:divine cannons] that fire lasers upon release
			Inflicts [cebuff:CalamityEntropy/VoidTouch]
			'Void is an ever potent element, only a few drops are needed for complete annihilation'
			'''
	}

	FriendBox: {
		DisplayName: Friend Box
		Tooltip:
			'''
			Summons a pair of orbiting twins that clone your projectiles
			Duplicated projectiles deal 100% damage of the original weapon
			Each pair of twins take 4 summon slots
			'''
	}

	LightningPendant: {
		DisplayName: Lightning Pendant
		Tooltip: Summons Storm Weaver-Chan
	}

	EvilFriend: {
		DisplayName: Evil Plush
		Tooltip: Summons a brimstone spirit that unleashes lasers
	}

	TheocracyPearlToy: {
		DisplayName: Theocracy Pearl Toy
		Tooltip: Summons Cruiser-Chan
	}

	CruiserTrophy: {
		DisplayName: Cruiser Trophy
		Tooltip: ""
	}

	VoidMonolith: {
		DisplayName: Void Monolith
		Tooltip: "'The moon lord's darkness holds no candle to this'"
	}

	VoidToy: {
		DisplayName: Void Toy
		Tooltip: Summons a cruiserling void pal
	}

	WingsOfHush: {
		DisplayName: Wings of Hush
		Tooltip: Fires a piercing void laser alongside four smaller [ceeffect/cruiser:voidbeams] that all inflict [cebuff:CalamityEntropy/VoidTouch]
	}

	SoyMilk: {
		DisplayName: Soy Milk
		Tooltip:
			'''
			Multiplies attack speed by 3
			Divides damage dealt by 3
			'''
	}

	DarkArts: {
		DisplayName: Dark Arts
		Tooltip:
			'''
			Inflicts you with [cebuff:CalamityEntropy/StealthState], which gives complete immunity and marks all enemies and projectiles you touch
			Damages all marked entities and clears all marked projectiles after the effect wears off
			'''
	}

	VenomPiece: {
		DisplayName: Venom Piece
		Tooltip: Summons a melon cat
	}

	WisdomCard: {
		DisplayName: Oracle Card 『Wisdom』
		Tooltip:
			'''
			[COST]% decreased mana cost
			'Victory follows those in pursuit of facts'
			'''
	}

	TemperanceCard: {
		DisplayName: Oracle Card 『Temperance』
		Tooltip:
			'''
			Increases your max number of minions by [T]
			'Restrain your desire to gain the loyalty of legions'
			'''
	}

	RadianceCard: {
		DisplayName: Oracle Card 『Radiance』
		Tooltip:
			'''
			[LR]% increased life regeneration speed
			'Ensure you be one's light to mend the soul'
			'''
	}

	OracleDeck: {
		DisplayName: Oracle Deck
		Tooltip:
			'''
			+[ST]% damage, +[CR]% critical strike chance, 5% damage reduction
			+10% movement speed, +[ATS]% melee attack speed, -10% mana cost
			+[MN] max minion, +100% light
			Every 10 seconds, you and nearby teammates recover 20 life
			A single hit cannot deal more than 66.7% of your max life; this protection has a 5 second cooldown
			'''
	}

	MetropolisCard: {
		DisplayName: Oracle Card 『Metropolis』
		Tooltip:
			'''
			5% increased damage
			'Sleight shall be found in deep and darker places'
			'''
	}

	InspirationCard: {
		DisplayName: Oracle Card 『Inspiration』
		Tooltip:
			'''
			20% increased movement speed
			'Epiphany shall strike you as swiftly as the wind'
			'''
	}

	EntityCard: {
		DisplayName: Oracle Card 『Entity』
		Tooltip:
			'''
			10% increased attack speed
			'Adrenaline leaves fleshy kind as swift as the shadows'
			'''
	}

	EnduranceCard: {
		DisplayName: Oracle Card 『Endurance』
		Tooltip:
			'''
			Reduces damage taken by 5%
			'Steel tempered with such will shall hold up the mountains'
			'''
	}

	BrillianceCard: {
		DisplayName: Oracle Card 『Brilliance』
		Tooltip:
			'''
			Light sources you emit are brighter
			'In a world bathed in darkness, you must bring eternal light'
			'''
	}

	AuraCard: {
		DisplayName: Oracle Card 『Aura』
		Tooltip:
			'''
			+5% increased critical strike chance
			'A flash of insight is all that's needed for a fatal strike'
			'''
	}

	ThreadOfFate: {
		DisplayName: Thread of Fate
		Tooltip:
			'''
			Intertwines the mystic cards of the [i:CalamityEntropy/OracleDeck][c/87CEFA:Oracle Deck]
			[c/87CEFA:Hold SHIFT to read the thread...]
			'''
		HoldShiftForDetails:
			'''
			[i:CalamityEntropy/AuraCard]Aura Card
			Scattered across hidden cabins and submerged crates...
			[i:CalamityEntropy/BrillianceCard]Brilliance
			Sold by an eccentric, mysterious merchant...
			[i:CalamityEntropy/EntityCard]Entity
			Offered to a pearly psychic of the sunken sea...
			[i:CalamityEntropy/InspirationCard]Inspiration
			Left to rot in the sifting sands...
			[i:CalamityEntropy/MetropolisCard]Metropolics
			Scribed from many common books...
			[i:CalamityEntropy/WisdomCard]Wisdom
			Held by the dungeon's accursed warden...
			[i:CalamityEntropy/RadianceCard]Radiance
			Requires the magic of a hallowed orb...
			[i:CalamityEntropy/TemperanceCard]Temperance
			Used as a spiritual anchor for a mechanical monstrosity...
			[i:CalamityEntropy/EnduranceCard]Endurance
			Tested in the part of the sea the light shall never touch...
			'''
	}

	RuneSong: {
		DisplayName: Archaic Song
		Tooltip:
			'''
			Briefly charge up before sweeping the blade in a wide arc
			If it hits an enemy, the blade recoils before rapidly spinning the blade around you
			If the initial sweep misses, the next swing will instead aim at the cursor and fires a rune pulse
			All attacks inflict [cebuff:CalamityEntropy/SoulDisorder]
			'''
	}

	GalaxyGrapeSoda: {
		DisplayName: Galaxy Grape Soda
		Tooltip:
			'''
			A blend of fresh grapes, godly essence, and...crimliate guardians?
			Turns you into a true Devourer of Gods
			'''
	}

	VoidAnnihilate: {
		DisplayName: Nihil Orbit
		Tooltip:
			'''
			Click LMB or hold RMB to throw some [ceeffect/cruiser:Orbit knives]
			After hitting a target, they will bounce off and float around
			Long press the left button to build up momentum
			When fully charged,
			releasing it will throw an enhanced knife that causing triple damage
			Enhancing knives will cause all floating knives to hit the target
			'''
	}

	AuricBoulder: {
		DisplayName: Auric Boulder
		Tooltip: From the great creator Red-tropy
	}

	DustyStar: {
		DisplayName: Dusty Star
		Tooltip: Grants the appearance of the head developer
	}

	SoulCandle: {
		DisplayName: Soul Candle
		Tooltip:
