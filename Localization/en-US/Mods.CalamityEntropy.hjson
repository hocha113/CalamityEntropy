	KosRunePendant: {
		DisplayName: Kos Rune Pendant
		Tooltip: Summons Devourer-Chan and his chibi servants
	}

	OdinsRefuge: {
		DisplayName: Odin's Refuge
		Tooltip:
			'''
			Grants the same debuff immunities as the Ankh Charm
			Grants immunity to knockback
			Lets you walk on fire blocks
			Grants the Holy Mantle's blocking effect
			You and your teammates take 15% less damage (does not stack)
			Enemies are more likely to target you
			'''
		ToggleEffectOn: "[c/00ff00:Panic enabled]"
		ToggleEffectOff: "[c/808080:Panic disabled]"
