			'''
			Extends invincibility duration by [T]%
			'Ghostly murmurs, etherial whispers, those on high slip secrets of this plane...'
			'''
	}

	MourningCard: {
		DisplayName: Soul Card - Mourning
		Tooltip:
			'''
			Lessens the efficacy of stat decreasing instances for defense, damage, critical strike chance, damage reduction and life regeneration
			'The numbness of sorrow can fend off the worst of the world at times...'
			'''
	}

	IndigoCard: {
		DisplayName: Soul Card - Indigo
		Tooltip:
			'''
			Increases flight speed by [T]% and flight time by [T2]
			'Azure souls soar, guided by the very wind they make up...'
			'''
	}

	BitternessCard: {
		DisplayName: Soul Card 『Woe』
		Tooltip:
			'''
			The less hurt you are, the more damage you do, while the more hurt you are, the less damage you take
			Up to [1]% more damage and [2]% damage reduction
			'Fury from pain & misery is more primal than any other emotion...'
			'''
	}

	DevouringCard: {
		DisplayName: Soul Card - Soul Rend
		Tooltip:
			'''
			Attacks ignore [1]% of enemy defense
			'The starving souls of one's sins gnaw at their will...'
			'''
	}

	CursedThread: {
		DisplayName: Cursed Thread
		Tooltip:
			'''
			Used to intertwine the [i:CalamityEntropy/SoulDeck][c/ADFF2F:Soul Deck]
			[c/ADFF2F:Hold SHIFT to read the thread...]
			'''
		HoldShiftForDetails:
			'''
			The following materials are required:
			[i:CalamityEntropy/RequiemCard][c/ADFF2F: Requiem]
			Notes from spirits released after the death of Plantera...
			[i:CalamityEntropy/WisperCard][c/ADFF2F: Whisper]
			Echoes of snips and snaps in the pinnacle of symbiosis...
			[i:CalamityEntropy/PurificationCard][c/ADFF2F: Purification]
			Found in living chests infused with hallowed energy...
			[i:CalamityEntropy/ObscureCard][c/ADFF2F: Obscure]
			Sunken in the fluids of dead gods...
			[i:CalamityEntropy/GrudgeCard][c/ADFF2F: Grudge]
			Extracted from a dozen spirits' ectoplasm using a transmutative liquid...
			[i:CalamityEntropy/IndigoCard][c/ADFF2F: Indigo]
			Hidden in lakes upheld by the clouds...
			[i:CalamityEntropy/MourningCard][c/ADFF2F: Mourning]
			A moral code of the protector of a lost jungle civilization...
			[i:CalamityEntropy/BitternessCard][c/ADFF2F: Woe]
			Fuels the beasts of a land ever so blighted...
			[i:CalamityEntropy/DevouringCard][c/ADFF2F: Soulrend]
			Found eating at the hallowed plating of a dungeon defender...
			'''
	}

	SoulDeck: {
		DisplayName: Soul Deck
		Tooltip:
			'''
			Reduces most cooldowns by [CD]%
			Increases immunity time on hit by [IM]%
			Shortens debuff durations by [DB]%
			Enemy contact greatly increases health regen, restores flight time and inflicts [cebuff:CalamityEntropy/SoulDisorder]
			Hitting enemies may release souls that fly to you, healing 2 life with 1 additional life for every 160 maximum life, restoring 10 mana and granting 6 temporary defense
			Increases flight speed by [FL]% and duration by [FT]%
			Slows the rate of decline when defense, damage, critical strike chance, damage reduction or life regeneration decrease
			The higher your health, the higher your damage (up to [BD]%)
			The lower your health, the higher your damage reduction (up to [BE]%)
			Attacks ignore [AP]% of enemy defense
			'''
	}

