	VoidCruiseDye: {
		DisplayName: Void Cruise Dye
		Tooltip: ""
	}

	AbyssalPiercer: {
		DisplayName: Abyssal Piercer
		Tooltip:
			'''
			Throws a drowned javelin that erupts into homing abyssal water on impact and inflicts [cebuff:CalamityEntropy/CrushDepth]
			Hitting enemies builds momentum; when full, your next attack becomes an ultimate
			Ultimate: an empowered throw that pierces up to 5 enemies
			'''
	}

	AmethystFrisbee: {
		DisplayName: Amethyst Frisbee
		Tooltip:
			'''
			Alternates between piercing and bouncing throws
			Charges while held; when full, your next attack becomes an ultimate
			Ultimate: throws an empowered frisbee with greatly increased damage and velocity
			'''
	}

	Aquashard: {
		DisplayName: Aquashard
		Tooltip:
			'''
			Throws a javelin that spawns water bullets when hit
			Hitting enemies builds momentum; when full, your next attack becomes an ultimate
			Ultimate: an empowered throw that pierces up to 5 enemies
			'''
	}

	ArbitratorII: {
		DisplayName: Arbitrator II
		Tooltip:
			'''
			Throws an exploding javelin
			Usable only when the ultimate is ready; needs a moment to recharge after release
			Ultimate: hurls an empowered arbitrator blade
			'''
	}

	AzafureAirReaper: {
		DisplayName: Azafure Air Reaper
		Tooltip:
			'''
			Throws a sickle that embeds itself into enemies and inficts [cebuff:CalamityEntropy/MechanicalTrauma]
			Charges while held; when full, your next attack becomes an ultimate
			Ultimate: the sickle latches on and drags around the enemy far longer
			'''
	}

	AzafureLightMachineGun: {
		DisplayName: Azafure Light Machine Gun
		Tooltip:
			'''
			Fires a continuous laser
			Hitting enemies builds momentum; when full, your next attack becomes an ultimate
			Ultimate: the next shot fires a sniper round dealing 6x damage
			Attacks inflict the [cebuff:CalamityEntropy/MechanicalTrauma] debuff
			'''
	}

	AzafureSurgeRod: {
		DisplayName: Azafure Surge Rod
		Tooltip:
			'''
			Throws a blade that lodges itself into enemies and bursts after a short delay
			The blade inflicts [cebuff:CalamityEntropy/MechanicalTrauma] and bursts after a short time
			Charges while held; when full, your next attack becomes an ultimate
			Ultimate: fires a volley of 6 wall-piercing homing javelins that unleash red tesla chains on hit
			'''
	}

	AzureOfFirmament: {
		DisplayName: Azure of Firmament
		Tooltip:
			'''
			Throws a light-infused javelin
			Charges while held; when full, your next attack becomes an ultimate
			Ultimate: launches a ring of 12 firmament feathers; the main bolt pierces up to 5 enemies
			'''
	}

	CrystalSpike: {
		DisplayName: Crystal Spike
		Tooltip:
			'''
			Throws vile crystals that embed themselves into enemies, up to [S] per target
			When [U] crystals are planted, your next throw recalls and empowers them all
			Recalled crystals become empowered shots and are thrown again
			Ignores 4 points of defense
			'''
	}

	EmberSpike: {
		DisplayName: Ember Spike
		Tooltip:
			'''
			Throws hot embers that melt into targets and explode on hit
			Hitting enemies builds momentum; when full, your next attack becomes an ultimate
			Ultimate: spikes bounce up to 5 times and release homing tectonic shards on burst
			Ignores 8 points of defense
			'''
	}

	LunarPlank: {
		DisplayName: Lunar Plank
		Tooltip:
			'''
			Throws a lunar plank to strike enemies 
			Charges while held; when full, your next attack becomes an ultimate
			Ultimate: the plank grows larger; its impact triggers a starlight explosion and homing star bolts
			'''
	}

	MewMewBomb: {
		DisplayName: Mew Mew Bomb
		Tooltip:
			'''
			[c/FF69B4:Throw a bomb that bounces off blocks]
			[c/FF69B4:After hitting a target, it bounces to a position that can hit as many targets as possible and explodes in a cross pattern]
			[c/FF69B4:Usable only when the ultimate is ready; needs a moment to recharge after release]
			[c/FF69B4:Ultimate: a bigger, fiercer explosion with a wider and longer cross shockwave]
			[c/FF69B4:Players who are hit by the explosion will receive 2.5 seconds of invincibility]
			[c/FF69B4:"A detonator with cat ears, somehow it emits cat meows"]
			'''
	}

	ProphecyFlyingKnife: {
		DisplayName: Prophetic Daggers
		Tooltip:
			'''
			Flings 4 daggers in a random arc that fly towards enemies after a moment in the air
			Hitting enemies builds momentum; when full, your next attack becomes an ultimate
			Ultimate: the main dagger deals double damage, flanked by volleys of side daggers
			'''
	}

	Revelation: {
		DisplayName: Revelation
		Tooltip:
			'''
			Throws a spinning scythe that rapidly slows in midair,
			then explodes and fires two homing Revelation Beams before returning to the player
			On return, it deals damage again if hitting an enemy
			Charges while held; when full, your next attack becomes an ultimate
			Ultimate: hurls 3 homing revelation scythes that relay-slash on hit
			'''
	}

	ScorchingChakram: {
		DisplayName: Scorching Chakram
		Tooltip:
			'''
			Throws a chakram that pierces and explodes into shards in midair
			Chakrams inflict [cebuff:OnFire] on impact
			Charges while held; when full, your next attack becomes an ultimate
			Ultimate: the chakram lingers on enemies with continuous slicing, releasing a ring of homing tectonic shards on burst
			'''
	}

	ShadewindLance: {
		DisplayName: Shadewind Lance
		Tooltip:
			'''
			Throws a void-infused javelin that creates a small burst on impact
			Hitting enemies builds momentum; when full, your next attack becomes an ultimate
			Ultimate: the lance pierces infinitely and flies faster
			Inflicts [cebuff:CalamityEntropy/VoidTouch]
			'''
	}

	Silence: {
		DisplayName: Silence
		Tooltip:
			'''
			Throw a [ceeffect/cruiser:void-chained frisbee] that pulls itself back to enemies on hit after a short delay before exploding on impact]
			Charges while held; when full, your next attack becomes an ultimate
			Ultimate: fires a specialized blade of silence that chains the target and unfolds a devouring vortex
			'''
	}

	SpearOfRadiance: {
		DisplayName: Spear of Radiance
		Tooltip:
			'''
			Throws a blessed javelin
			Hitting enemies builds momentum; when full, your next attack becomes an ultimate
			Ultimate: an empowered throw that pierces up to 5 enemies
			'''
	}

	Apeirokyklos: {
		DisplayName: Apeirokyklos
		Tooltip:
			'''
			Deploys a multi-hit sawblade when flies for a while or hits an enemy 
			Each hit of the sawblade summons an Abyss Spike from below to pierce the target
			Charges while held; when full, your next attack becomes an ultimate
			Ultimate: a much larger and longer spin; on hit, recoils to charge and re-enter, calling down a rain of spikes
			'''
	}

	AzafureSwirlblade: {
		DisplayName: Azafure Swirlblade
		Tooltip:
			'''
			Throw a sawblade that on hit or after some time stops in place, releasing a pair of homing missiles before spinning
			The sawblade deals damage in a large area when spinning and will return after some time
			Charges while held; when full, your next attack becomes an ultimate
			Ultimate: a larger spin, bursting a ring of homing fire bolts on deployment
			Attacks inflict [cebuff:CalamityEntropy/MechanicalTrauma] on hit
			'''
	}

	BlazingSwirlblade: {
		DisplayName: Blazing Swirlblade
		Tooltip:
			'''
			Throw a sawblade that on hit or after some time stops in place, releasing a holy heatwave before spinning
			The sawblade deals damage in a large area when spinning and will return after some time
			Charges while held; when full, your next attack becomes an ultimate
			Ultimate: a much larger and longer spin, spewing holy fire in 8 directions
			Attacks inflict [cebuff:CalamityEntropy/HolyFlames] on hit
			'''
	}

	BrillianceSwirlblade: {
		DisplayName: Brilliance Swirlblade
		Tooltip:
			'''
			Throw a sawblade that on hit or after some time stops in place and starts spinning
			The sawblade deals damage in a large area when spinning and will return after some time
			Charges while held; when full, your next attack becomes an ultimate
			Ultimate: a much larger spin that lasts longer
			'''
	}

	ExergySwirlblade: {
		DisplayName: Exergy Swirlblade
		Tooltip:
			'''
			Flies for a while or hits an enemy, then deploys a multi-hit sawblade that shrinks over time
			If deployed by enemy contact, the ringblade sticks to that enemy
			As the sawblade shrinks, it fires smaller homing sawblades that stop tracking after one hit
			Charges while held; when full, your next attack becomes an ultimate
			Ultimate: a larger spin that keeps firing homing sawblades while deployed
			'''
	}

	FlamingSwirlblade: {
		DisplayName: Flaming Swirlblade
		Tooltip:
			'''
			Throw a sawblade that on hit or after some time stops in place, releasing a homing flame bolt before spinning
			The sawblade deals damage in a large area when spinning and will return after some time
			Charges while held; when full, your next attack becomes an ultimate
			Ultimate: a larger spin, spewing flames in 8 directions on deployment
			Attacks inflict [cebuff:OnFire3] on hit
			'''
	}

	GlacierSwirlblade: {
		DisplayName: Glacier Swirlblade
		Tooltip:
			'''
			Throw a sawblade that on hit or after some time stops in place, releasing a pair of homing blades before spinning
			The sawblade deals damage in a large area when spinning and will return after some time
			Charges while held; when full, your next attack becomes an ultimate
			Ultimate: a larger spin that homes onto enemies, firing extra ice blades on return
			Attacks inflict [cebuff:CalamityEntropy/Deceive] on hit
			'''
	}

	RunicSwirlblade: {
		DisplayName: Runic Swirlblade
		Tooltip:
			'''
			Throw a sawblade that on hit or after some time stops in place, releasing a swarm of homing rune bolts before spinning
			The sawblade deals damage in a large area when spinning and will return after some time
			Charges while held; when full, your next attack becomes an ultimate
			Ultimate: unfolds a rotating ring of rune bolts around the spin, firing runes in all directions on return
			Attacks inflict [cebuff:CalamityEntropy/SoulDisorder] on hit
			'''
	}

	SawofMacrocosm: {
		DisplayName: Saw of Macrocosm
		Tooltip:
			'''
			Throw a sawblade that on hit or after some time stops in place, releasing 4 more smaller blades before spinning
			The sawblades deals damage in a large area when spinning and will return after some time
			Smaller blades on return release homing cosmic bolts at the closest enemy
			Charges while held; when full, your next attack becomes an ultimate
			Ultimate: locks a distant target and performs the Macrocosm Slash, a devastating strike dealing 8x damage
			Attacks inflict [cebuff:CalamityEntropy/GodSlayerInferno] on hit
			'''
	}

	TheBeginingAndTheEnd: {
		DisplayName: The Beginning And The End
		Tooltip:
			'''
			Left Click throws The Beginning, Right Click throws The End, both inflict the [cebuff:CalamityEntropy/LifeOppress] debuff
			The Beginning inflicts the [cebuff:CalamityEntropy/EclipsedImprint] debuff
			The End inflicts the [cebuff:CalamityEntropy/StareOfTheAbyss] debuff
			These debuffs both stack up to 8 times, when the opposite debuff is applied, that amount of Eclipse or Echo souls are created
			Eclipsed Souls return to you, restoring 4 life each and briefly granting the [cebuff:CalamityEntropy/ServiceBuff] buff
			Echo Souls relentlessly assault enemies for a short time
			Charges while held; when full, your next attack becomes an ultimate
			Ultimate: throws both blades at once, each dealing full damage
			'''
	}

	TheDeadCut: {
		Tooltip:
			'''
			Swings a decaying scythe that leaves a dead slice on hit
			Charges while held; when full, your next attack becomes an ultimate
			Ultimate: the dead slice gains rapid hits and homing; on hit, teleports to relay-slash up to 10 times
			'''
		DisplayName: The Dead Cut
	}

	Voidseeker: {
		DisplayName: Voidseeker
		Tooltip:
			'''
			Swings a void-touched scythe
			Hitting enemies builds momentum; when full, your next attack becomes an ultimate
			Ultimate: fires an empowered void bolt dealing double damage
			'''
	}
}

BaitCommonTooltip1: Charge when held. Usable when fully charged
BaitCommonTooltip2:
	'''
	Throw a bait that will stick to the enemy after hitting it,
	and cause minion deal {0} more damage to it
	'''
SmolderingSetBonus:
	'''
	Gain a demonic tail that attacks nearby enemies and inflicts [cebuff:OnFire3]
	Increases your maximum number of minions by 1
	8% increased weapon ultimate charge rate
	'''
ChaoticSetBonus:
	'''
	12% increased damage reduction
	12% increased damage
	+40 max life
	Increases your max number of minions by 3
	Releases three chaos cells on taking damage
	Cells will chase and attack enemies before returning and converting into 7 life each
	Press [KEY] to consume 80 life and spawn three cells
	You can have a maximum of [LIMIT] cells active at a time
	12% increased weapon ultimate charge rate
	'''
VoidEaterBonus:
	'''
	Every three seconds, send three nihil beams on enemy hit that inflict [cebuff:CalamityEntropy/VoidVirus]
	Project a shield that can withstand [SHIELD] damage
	The nihility shield needs ten seconds to recover once broken
	Press [KEY] to consume 80 life and accelerate the shield's recovery
	Grants +1HP/s life regeneration while the shield is broken
	Increases your max number of minions by 2
	Maximum mana increased by 100
	14% increased damage and critical strike chance
	12% increased weapon ultimate charge rate
	'''
VoidEaterSet: Void Eater Set
ChaoticSet: Chaotic Set
NihArmorConnet:
	'''
	Aim at another player that is wearing the [ANOTHERSET] and press the [CONNECT] button to connect
	During connection, gain an additional 2HP/s of health regeneration
	The health of the player with lower health is extracted to provide healing for another player
	When receiving fatal damage, if the other party can withstand the damage, 
	it will be borne by the other party, and this effect has a cooldown time of 12 seconds
	When connected, both parties will acquire the ability of nihility shield and chaotic cells
	'''
LOCKED: " [LOCKED]:"
BCU1: Requires defeating King Slime
BCU2: Requires defeating Perforator or Hive Mind
BCU2Own: Requires defeating Eater of Worlds or Brain of Cthulhu
BCU3: Requires defeating Wall of Flesh
BCU4: Requires defeating Plantera
BCC1: Right Click to extend thorny vines after a brief charge
BCC2:
	'''
	  Holding Right Click on a target pulls you toward it and deals impact damage
	  This skill consumes 20% of the Bramble Bar
	  Left Click swing hits slightly charge the Bramble Bar
	'''
BCC3:
	'''
	  Right Click then quickly Left Click to attach the weapon to the vines
	  While Left Click is held, the sword attaches to the struck target, 
	  Having the sword attached to an enemy grants continuous life steal that scales with the weapons level and slowly fills the Bramble Bar
	'''
BCC4:
	'''
	  Double tap and hold Right Click to throw the weapon,
	  While Right Click is held, the weapon rapidly pierces enemies near the cursor while continuously consuming Bramble Bar charge
	  Holding Left Click while the weapon is thrown spins the blade, releasing homing leaves
	'''
PrefixitemDesc: Right Click on a piece of armor with this to grant it a prefix
MariviniumSet:
	'''
	Provides a large area of light and improves visibility in the abyss
	Ignore water resistance while submerged, and flight time no longer drains
	Hold Down in water to sink faster; hold Jump and Down together to hover
	+4/s life regen, 20% reduced contact damage
	+3 max minions, +20% melee speed
	Gain 2 layers of abyssal shields that each block one hit over 50 damage
	The first layer takes 36 seconds to recover, the second takes 18 seconds
	Breaking a shield grants 10 seconds of Abyssal Wrath
	'''
DeathMode: Master Mode
ChargeReady: Ultimate Ready
CdMantle: Holy Mantle Cooldown
MissileLauncherDescTooltip: Launch missiles that get lodged into enemies and cause damage over time
MissileLauncherMaxStickTooltip: Up to {0} can be lodged in the same enemy

