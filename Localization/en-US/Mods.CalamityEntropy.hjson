		DisplayName: Azafure Circuitry
		Tooltip:
			'''
			The core wiring of Azafure machinery, its fine traces still hot to the touch
			Has a chance to be extracted from Hell Industrial Components in an Extractinator
			'''
	}

	AzafurePlating: {
		DisplayName: Azafure Plating
		Tooltip:
			'''
			A heat-resistant slice of Azafure armor, bullet scars still on its edge
			Has a chance to be extracted from Hell Industrial Components in an Extractinator
			'''
	}

	StarlitScaleDust: {
		DisplayName: Starlit Scale Dust
		Tooltip:
			'''
			Scale dust shed from glowing moth wings, like a handful of starlight
			Dropped at night by glowing mushroom biome enemies and lightning bugs
			'''
	}

	WraithSoulEssence: {
		DisplayName: Wraith Soul Essence
		Tooltip:
			'''
			Soul marrow drawn from the remains of the Nihility Twins, cold enough to burn
			Obtained by defeating the Nihility Twins
			'''
	}

	EntropyStarterBag: {
		DisplayName: Gift of Entropy
		Tooltip:
			'''
			Right Click to open
			Holds gifts from the contributors
			'''
	}

	TlipocasScythe: {
		DisplayName: Tlipoca's Scythe
		Tooltip:
			'''
			Charges while held; when full, your next attack becomes an ultimate
			Ultimate: the spinning scythe is fully empowered, with larger and heavier slashes
			'''
	}

