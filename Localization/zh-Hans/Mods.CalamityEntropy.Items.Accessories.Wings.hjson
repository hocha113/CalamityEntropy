FlowingLight: {
	DisplayName: 仙萤流光
	Tooltip:
		'''
		{$CommonItemTooltip.FlightAndSlowfall}
		按住↓以加速下落
		飞行时按住↓以悬停
		免疫熔岩与着火，不受摔落伤害
		可在水面与冰面上疾行，大幅提升移动速度
		$“臻至化境”
		'''
}

PhantomLightWing: {
	DisplayName: 幻光星翼
	Tooltip:
		'''
		{$CommonItemTooltip.FlightAndSlowfall}
		飞行时留下星光尾迹
		'''
}

RuneWing: {
	DisplayName: 翱翔符文
	Tooltip:
		'''
		{$CommonItemTooltip.FlightAndSlowfall}
		按[KEY]向鼠标方向进行一次灵魂冲刺，距离40格，冷却[CD]秒
		灵魂冲刺全程无敌，可以穿过敌方弹幕和平台
		'''
}

BigShotsWing: {
	DisplayName: 大人物翅膀
	Tooltip:
		'''
		{$CommonItemTooltip.FlightAndSlowfall}
		有Boss存在时-90%飞行时间
		因为被提线操纵，飞行速度较慢
		“是时候成为...”
		按住Shift并点击右键切换提线可见度
		提线[TOGGLE]
		'''
	Visual0: 可见
	Visual1: 半透明
	Visual2: 隐藏
}

IceShardWing: {
	DisplayName: 冰晶之翼
	Tooltip:
		'''
		{$CommonItemTooltip.FlightAndSlowfall}
		“实际上使用魔法飞行”
		'''
}

TheRevelation: {
	DisplayName: 终末天启
	Tooltip:
		'''
		{$CommonItemTooltip.FlightAndSlowfall}
		长按鼠标使用武器时蓄力，蓄力满时松开鼠标释放一道圣光，每3帧造成50点伤害
		视为翅膀
		飞行时按住下以悬停
		“唤醒你的信仰”
		'''
}

VoidElytra: {
	DisplayName: 虚空推进鞘翅
	Tooltip:
		'''
		{$CommonItemTooltip.FlightAndSlowfall}
		双击任意方向键进行冲刺，每次消耗少量飞行时间
		飞行时间不足时仍可冲刺，改为受到虚空侵蚀扣除生命值
		[c/356498:将生命献给虚空，得到对极限的突破]
		'''
}
