			{$BaitCommonTooltip2}
			召唤藤蔓刺穿目标
			'''
	}

	MechanicalTransmitter: {
		DisplayName: 机械发讯器
		Tooltip:
			'''
			{$BaitCommonTooltip1}
			{$BaitCommonTooltip2}
			召唤一些探测器用激光攻击目标
			'''
	}

	MagicHat: {
		DisplayName: 魔术帽
		Tooltip:
			'''
			{$BaitCommonTooltip1}
			{$BaitCommonTooltip2}
			召唤3只鸽子攻击目标
			'''
	}

	KamishiroKou: {
		DisplayName: 神代工的破损主人公护目镜
		Tooltip:
			'''
			“如果被选召是一个彻头彻尾的谎言，为的只是把我们装进盒子里变为进化食粮……
			捏着有着后门的神圣计划，在这数码缅北中，我们又该何去何从呢？”
			'''
	}

	FrostboundCage: {
		DisplayName: 寒霜锢笼
		Tooltip:
			'''
			{$BaitCommonTooltip1}
			{$BaitCommonTooltip2}
			释放被囚禁的恶灵们，它们会使用追踪冰弹攻击目标
			'''
	}

	BlueFlatTopMushroom: {
		DisplayName: 蓝色平顶菇
		Tooltip:
			'''
			{$BaitCommonTooltip1}
			{$BaitCommonTooltip2}
			召唤一只蓝狐
			蓝狐会偷走蘑菇并释放一团孢子云
			'''
	}

	SacredStone: {
		DisplayName: 圣火流石
		Tooltip:
			'''
			{$BaitCommonTooltip1}
			{$BaitCommonTooltip2}
			黏附后经过两秒的再次充能会从目标身上弹出，并释放圣火焚烧目标
			'''
	}

	BottledFissure: {
		DisplayName: 瓶装裂隙
		Tooltip:
			'''
			{$BaitCommonTooltip1}
			{$BaitCommonTooltip2}
			黏附一段时间后炸开，释放[ceeffect/cruiser:噬虚弹]反复撕咬目标
			'''
	}

	AzafureWarSatelliteAuthorizationKey: {
		DisplayName: 阿萨福勒战争卫星密钥
		Tooltip:
			'''
			{$BaitCommonTooltip1}
			{$BaitCommonTooltip2}
			召唤阿萨福勒战争卫星打击目标
			'''
	}

	Fooveria: {
		DisplayName: 霜痕
		Tooltip:
			'''
			“杀戮与世界意志滋养的武器，前来助您净化这个世界。”
			在击败克苏鲁之眼后，手持且未攻击时增加6点防御
			随时期增强: [L] / 15
			'''
	}

	AzafureTwinSaw: {
		DisplayName: 阿萨福勒双锯
		Tooltip: 上下挥舞，随后将两把锯子贴合并向前喷射火花
	}

	AstralSample: {
		DisplayName: 星辉样本
		Tooltip:
			'''
			使你化身为驾驶员降翎者
			“
			白金星舰在被改造为自动化机械前其实曾使用过生物的驾驶兼采样员
			也许是因为首领们迫不及待地妄想掌控星辉病毒，
			但是甚至可以侵蚀无机体的瘟疫又怎么会放过这些生灵。
			”
			'''
	}
}

BaitCommonTooltip1: 手持时充能，只能在充能完成时丢出
BaitCommonTooltip2: 命中敌人后会黏住，并使仆从对其增加{0}点标记伤害
SmolderingSetBonus:
	'''
	召唤一条灼烬之尾
	灼烬之尾会远程攻击附近的敌人，并受伤害加成最高的职业加成
	仆从数量上限提高1
	增加80点潜行值
	'''
ChaoticSetBonus:
	'''
	增加40点最大生命值，12%伤害和12%伤害减免
	增加3最大仆从栏位并增加120点最大魔力值
	玩家受伤时会释放小型混沌细胞
	细胞会追逐并攻击敌人，并在一段时间后返回并被转化为生命值
	按[[KEY]]([KN])手动消耗生命值召唤3只细胞
	最多同时存在[LIMIT]个细胞
	+120点最大潜行值
	'''
VoidEaterBonus:
	'''
	增加14%伤害和暴击率
	增加2最大仆从栏位并增加100点最大魔力值 
	攻击命中时向目标发射几道激光，有3秒冷却
	投射出一片具有[SHIELD]点耐久的护盾
	护盾破碎后需要10秒恢复，在此期间增加1/s生命再生
	按下[[KEY]]([KN])以消耗生命值加速护盾恢复
	+120点最大潜行值
	'''
VoidEaterSet: 噬虚者套装
ChaoticSet: 混沌套装
NihArmorConnet:
	'''
	对准另一名穿着[ANOTHERSET]的玩家按下[[CONNECT]]键以进行连接
	连接时额外增加2/s生命再生，并将生命值较低的一方的生命值抽取为另一名玩家提供治疗
	受到致命伤害时，如果对方可承受此伤害，将由对方承担，这个效果有12秒冷却时间
	连接时，双方都会获得虚无护盾和混沌细胞的能力
	'''
LOCKED: ：[已锁定]
BCU1: 需击败史莱姆王
BCU2: 需击败血肉宿主或腐巢意志
BCU3: 需击败血肉墙
BCU4: 需击败世纪之花
BCC1: 右键后经短暂前摇后伸出藤蔓刺出
BCC2:
	'''
	* 持续按住右键刺中目标会将你拉过去并撞击目标，
	  此技能消耗20%苍郁充能条，左键命中会增加少量充能。
	'''
BCC3:
	'''
	* 右键后快速按下左键将武器扔出，
	  剑会附着在刺中的目标上，为你持续回复血量，飞行时间，缓慢增加充能，并提供部分护甲
	'''
BCC4:
	'''
	* 双击并按住右键将武器抛出，持续消耗充能，并让武器持续来回穿刺光标附近的敌怪，
	  此时按住左键可以旋转刀刃，持续发射追踪弹幕。
	'''
PrefixitemDesc:
	'''
	用于给护甲添加词缀
	在物品栏中右键护甲物品
	'''
MariviniumSet:
	'''
	提供大范围的照明，并使你能在深渊看清
	在水中时，无视阻力并无限飞行，按住下以加速下落，同时按住跳跃和下可以悬停
	降低20%接触伤害，大幅增加生命再生，并使玩家免疫绝大多数的减益
	增加10个最大仆从栏位，75%召唤伤害和135点潜行值
	使用真近战武器时增加10%伤害减免和15防御
	盗贼潜伏攻击有几率产生高伤害的水爆炸
	获得2层可以抵挡伤害的护盾，第一层护盾恢复需要36秒的时间，第二层需要18秒
	护盾破损会让玩家回复100点生命值，同时获得10秒“深渊狂怒”增益，增加50%伤害
	护盾不会抵御造成伤害低于5%最大生命值的攻击
	'''
DeathMode: 死亡模式
