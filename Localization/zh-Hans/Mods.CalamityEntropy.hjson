ModNameOverride: 灾厄熵

Items: {
	VoidBlade: {
		DisplayName: 虚空锋刃
		Tooltip: 快速，连续的进行斩击
	}

	Weapons: {
		Rogue: {
			Revelation: {
				DisplayName: 启示录
				Tooltip:
					'''
					扔出一把旋转的镰刀，在空中会快速减速，随后爆炸并发射两发追踪的启示光束并返回玩家
					返回时如果命中敌怪能再次造成一次伤害
					潜伏攻击会扔出三把镰刀，并追踪向离你最近的敌怪，命中后会融合为一把巨大的镰刀，并多次砸向该敌怪
					巨化的镰刀每次命中都会产生大范围的爆炸
					'''
			}

			Silence: {
				DisplayName: 沉默
				Tooltip:
					'''
					丢出一个飞盘，击中敌人后一段时间会使用[ceeffect/cruiser:虚空锁链]将自身拉向该敌人，并在与其接触时爆炸
					潜伏攻击会使飞盘被固定在击中的敌人身上并展开一个大范围漩涡，持续对范围内的目标造成伤害
					'''
			}

			ShadewindLance: {
				DisplayName: 苍穹坠影
				Tooltip:
					'''
					扔出一把被虚空赋能的标枪
					潜伏攻击会有更高的伤害和速度并能无限穿透
					'''
			}

			Aquashard: {
				DisplayName: 蓝晶破浪
				Tooltip:
					'''
					丢出一把击中敌人会抛射水弹的标枪
					潜伏攻击会获得穿透并且在标枪飞行时留下棱镜碎片，同时击中后持续以目标为中心生成追踪水弹
					'''
			}

			SpearOfRadiance: {
				DisplayName: 圣辉之枪
				Tooltip:
					'''
					投出一把神圣标枪
					潜伏攻击会获得更多穿透并且第一次击中会迸发出十字圣光
					'''
			}

			AbyssalPiercer: {
				DisplayName: 冥海穿刺
				Tooltip:
					'''
					丢出一把击中后迸发出追踪水流的标枪
					潜伏攻击会在第一次命中后产生一个深渊漩涡并伸出裂礁刺
					'''
			}

			AzureOfFirmament: {
				DisplayName: 天穹之澈
				Tooltip:
					'''
					丢出一把苍穹标枪
					潜伏攻击会同时散射出羽毛
					标枪击中目标后羽毛会飞向目标
					'''
			}

			ArbitratorII: {
				DisplayName: 仲裁者II
				Tooltip:
					'''
					丢出一把会爆炸的标枪
					潜伏攻击会插在目标身上并产生电弧冲击
					'''
			}

			Voidseeker: {
				DisplayName: 苍茫长镰
				Tooltip:
					'''
					从下往上挥砍的镰刀
					潜伏攻击会传送到光标位置并从上往下进行一次更大的挥砍
					传送后获得短暂无敌时间
					'''
			}

			TheBeginingAndTheEnd: {
				DisplayName: 始与末
				Tooltip:
					'''
					使用左右键射出不同的飞刀
					终会造成虚渊凝视减益
					始会造成冥煌烙印减益
					当另一种飞刀击中后清除该减益并根据减益的层数生成回音之魂或冥煌之魂
					回音之魂会持续攻击敌怪，数秒后消失
					冥煌之魂会飞向你并治疗你，同时暂时提升攻击速度、攻击伤害和暴击率
					潜伏攻击同时丢出两把飞刀并追踪目标，击中后迸发出大量两种灵魂
					'''
			}

			AmethystFrisbee: {
				DisplayName: 紫晶飞盘
				Tooltip:
					'''
					扔出一个击中会自动返回的飞盘
					返回的瞬间再次投出无视重力并造成高频伤害
					潜伏攻击会在命中敌人后产生冲击，对附近敌怪造成伤害
					'''
			}

			ProphecyFlyingKnife: {
				DisplayName: 预言飞刀
				Tooltip:
					'''
					发射一些旋转的飞刀，在目标周围短暂停滞后高速飞向并穿刺目标
					旋转时的飞刀不会造成伤害
					潜伏攻击会发射一柄较大的飞刀，击中后召唤6个符文球攻击敌怪，同时发射两柄追踪的小型飞刀
					'''
			}

			TheDeadCut: {
				Tooltip:
					'''
					丢出一把飞镰，命中后生成虚妄斩切
					潜伏攻击会使飞镰命中后进行多次斩切
					'''
				DisplayName: 虚妄切裂者
			}

			LunarPlank: {
				DisplayName: 幻光石板
				Tooltip:
					'''
					扔出并砸向你的敌人
					潜伏攻击会造成范围伤害并释放几发追踪幻光矢
					'''
			}

			AzafureSurgeRod: {
				DisplayName: 阿萨福勒电涌钎
				Tooltip:
					'''
					击中后插在目标上，一段时间后朝附近的其他目标迸发出闪电
					潜伏攻击会丢出更多投掷物，悬停在空中并追踪附近目标
					'''
			}

			TlipocasScythe: {
				DisplayName: 特莉波卡的镰刀
				Tooltip: ""
			}

			AzafureLightMachineGun: {
				DisplayName: 阿萨福勒轻机枪
				Tooltip:
					'''
					快速发射激光
					激光命中后为你回复少量潜行值
					潜伏攻击将发射一枚会爆炸的榴弹，造成范围伤害
					'''
			}

			AzafureAirReaper: {
				DisplayName: 阿萨福勒压力统镰
				Tooltip:
					'''
					扔出一把镰刀，击中后黏附在目标上造成多次伤害
					潜伏攻击扔出一把在击中后持续追逐目标并来回斩切的镰刀
					'''
			}

			CrystalSpike: {
				DisplayName: 魔晶刺
				Tooltip:
					'''
					丢出并扎在目标身上，单个目标最多黏附[S]根
					潜行攻击会召回所有黏附的魔晶刺并向光标位置释放水晶风暴
					无视4点护甲
					'''
			}

			ScorchingChakram: {
				DisplayName: 焦灼旋刃
				Tooltip:
					'''
					丢出一个焦灼旋刃，并在飞行一段时间后炸成追踪的板块碎片
					潜行攻击会使旋刃在停止后发射一些火球，随后追逐最近的目标，并炸成更多的碎片
					'''
			}

			EmberSpike: {
				DisplayName: 余烬石锥
				Tooltip:
					'''
					丢出会在物块上反弹最多2次的余烬石锥
					命中敌怪后产生爆炸并扎在其身上，单个目标最多黏附[S]根
					潜行攻击会召回所有黏附的余烬石锥并向光标位置释放余烬风暴，能够在物块上反弹最多5次
					潜行命中会生成追踪的板块碎片
					无视8点护甲
					'''
			}

			MewMewBomb: {
				DisplayName: 喵喵炸弹
				Tooltip:
					'''
					[c/FF69B4:丢出一个会在物块上反弹的炸弹]
					[c/FF69B4:击中目标后会弹到一个能尽可能命中最多目标的位置并爆炸成十字]
					[c/FF69B4:潜伏攻击会使爆炸范围更大，并且爆炸可以命中玩家]
					[c/FF69B4:爆炸将对你造成20点伤害并给与你2.5秒的无敌时间]
					[c/FF69B4:"一个带有猫耳的雷管，不知为何它会发出猫叫"]
					'''
			}

			BrillianceSwirlblade: {
				DisplayName: 光耀轮刃
				Tooltip:
					'''
					飞行一段时间或触碰到敌怪时展开锯片，造成多次伤害
					潜伏攻击会使展开的范围更大并持续更长时间
					'''
			}

			FlamingSwirlblade: {
				DisplayName: 炙炎轮刃
				Tooltip:
					'''
					飞行一段时间或触碰到敌怪时展开锯片，造成多次伤害
					锯片展开时会释放一束追踪的火焰
					潜伏攻击会使展开的范围更大并持续更长时间并释放8束火焰
					'''
			}

			AzafureSwirlblade: {
				DisplayName: 阿萨福勒轮刃
				Tooltip:
					'''
					飞行一段时间或触碰到敌怪时展开锯片，造成多次伤害
					锯片展开时会发射两枚追踪的导弹
					潜伏攻击会在展开时发射8枚伤害较低的导弹并在收回时将锯片丢向最近的目标
					'''
			}

			GlacierSwirlblade: {
				DisplayName: 霜蓝轮刃
				Tooltip:
					'''
					飞行一段时间或触碰到敌怪时展开锯片，造成多次伤害
					随后释放一些追踪的小型锯片并返回
					潜伏攻击会在展开时持续追逐最近的目标，并在返回前释放更多更大的锯片
					所有攻击都能短暂使目标减速
					'''
			}

			RunicSwirlblade: {
				DisplayName: 符文轮刃
				Tooltip:
					'''
					飞行一段时间或触碰到敌怪时展开锯片，造成多次伤害
					展开时释放一些追逐的符文导弹
					潜伏攻击会大幅增加锯片尺寸，并在返回前释放更强大的符文导弹
					'''
			}

			BlazingSwirlblade: {
				DisplayName: 耀目轮刃
				Tooltip:
					'''
					飞行一段时间或触碰到敌怪时释放强大的火焰冲击并展开能造成多次伤害的锯片
					命中时会产生大范围的爆炸
					潜伏攻击会使展开的范围更大并持续更长时间
					'''
			}

			SawofMacrocosm: {
				DisplayName: 噬宙轮刃
				Tooltip:
					'''
					飞行一段时间后弹出4个较小的轮刃并展开大范围锯片
					小轮刃也会弹出锯片，并在收回时发射一道追踪的[ceffect/dog:虚空破裂束]
					潜伏攻击会使小锯片被弹的更远，并吸收小锯片的[ceffect/dog:虚空破裂束]，随即冲向最近的目标
					'''
			}

			ExergySwirlblade: {
				DisplayName: 裂界轮刃
				Tooltip:
					'''
					飞行一段时间或触碰到敌怪时展开能造成多次伤害的锯片，锯片会随时间缩小
					如果是触碰敌怪触发的锯片，则轮刃会黏附在该敌怪身上
					锯片缩小时会发射较小的追踪锯片，命中一次后停止追踪
					潜伏攻击会使展开的范围更大并持续更长时间，同时在最后发射一个较大的，持续追逐目标的锯片
					'''
			}

			Apeirokyklos: {
				DisplayName: 永渊环葬
				Tooltip:
					'''
					飞行一段时间或触碰到敌怪时展开能造成多次伤害的锯片
					锯片每次命中都会从下方召唤一根深渊尖刺刺穿目标
					潜伏攻击将会在命中后产生高伤害冲击并弹开，随后蓄力发射大量尖刺刺穿目标
					如果潜伏攻击没有命中目标，也会在飞行一段时间后展开，此时的锯片会更大，并且造成更高的伤害
					'''
			}
		}
	}

	PrisonOfPermafrost: {
		DisplayName: 至臻极冰之樊寒神像
		Tooltip:
			'''
			使用时会召唤一个魔法阵
			持续发射冰刺和冰锥
			[c/BEE2FF:"我超，冰！"]
			'''
	}

	Kinanition: {
		DisplayName: 孱弱血亲
		Tooltip:
			'''
			[c/ce97fa:左键发射一连串的闪电箭，]
			[c/ce97fa:闪电箭保留弹药原有效果，并在击中目标后生成追逐敌人的水流]
			[c/0078b9:右键发射一发追踪的雷电之矛，]
			[c/0078b9:击中目标后爆发出雷电]
			'''
	}

	VoidRelics: {
		DisplayName: 虚空圣契
		Tooltip:
			'''
			召唤至多一个[ceeffect/cruiser:窥虚之眼]，同时创造围绕自身的[ceeffect/cruiser:虚诞符文阵]
			符文会自动向附近的敌怪发射追踪的[ceefect/cruiser:窥虚冥弹]，同时伤害触碰的敌怪
			长按使用武器会将符文聚集在面前，并向光标方向快速发射大量[ceeffect/cruiser:窥虚冥弹]
			停止使用武器或持续使用超过6秒会还原符文并根据使用时间获得至多36秒的[ceeffect/cruiser:深渊狂舞]冷却，
			在冷却期间符文的攻速增加15%
			'''
	}

	AuricToilet: {
		DisplayName: 圣金马桶
		Tooltip:
			'''
			曾被寻神者使用过
			现在你也可以坐了
			“会唐走的”
			'''
	}

	LotteryBox: {
		DisplayName: 抽奖盒子
		Tooltip:
			'''
			生成一个抽奖机
			”脾气可能比较暴躁“
			'''
	}

	ToyRock: {
		DisplayName: 终末石玩具
		Tooltip:
			'''
			召唤妖龙酱
			“她还小呢”
			'''
	}

	YharimsStimulants: {
		DisplayName: 亚利姆牌兴奋剂
		Tooltip: 给你全属性的提升
	}

	VoidBottle: {
		DisplayName: 虚空瓶
		Tooltip: 召唤巡游者
	}

	VoidMonument: {
		DisplayName: 虚空符石
		Tooltip: ""
	}

	Lore: {
		CruiserLore: {
			DisplayName: 巡游者
			Tooltip: ""
			Lore: "{$loreCruiser}"
		}

		NihilityTwinLore: {
			DisplayName: 虚无双子
			Tooltip: ""
			Lore: "{$loreNihTwin}"
		}

		ProphetLore: {
			DisplayName: 先知
			Tooltip: ""
			Lore: "{$loreProphet}"
		}

		LuminarisLore: {
			DisplayName: 幻光星蛾
			Tooltip: ""
			Lore: "{$loreLuminaris}"
		}

		LoreApsychos: {
			DisplayName: 烬甲秽魔
			Tooltip: ""
			Lore:
				'''
				曾有人尝试将已死神明的精元封印其中。
				显然，他们失败了。
				这引起了这个岩浆深处的巨大生物的躁动，它开始不受控的攻击所有看见的活物。
				这简直是亵渎！多么无辜的生灵，被当作封印污秽的容器。
				诅咒缠绕的它终于得到了解脱。
				'''
		}

		LoreAcropolis: {
			DisplayName: 阿萨福勒卫城机甲
			Lore:
				'''
				这些机械本是阿萨福勒制作出来守卫城市的武装机器人，
				特质的金属外壳使它们在那场战斗中幸免于难。
				尽管已经过了许久，它们任然执行着自从被制造出来就设定好的程序，消灭一切未被允许的来访者。
				时间的流逝让它们变得迟钝，但凭借着精密高超的技术，它们仍然能利用环境的热量重新启动。
				'''
			Tooltip: ""
		}
	}

