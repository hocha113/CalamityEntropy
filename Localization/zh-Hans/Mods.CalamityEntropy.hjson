		DisplayName: 先驱者
		Tooltip: ""
	}

	GodsSnack: {
		DisplayName: 神明点心
		Tooltip: 召唤神吞酱
	}

	CruiserBag: {
		DisplayName: 宝藏袋（巡游者）
		Tooltip: ""
	}

	CruiserRelic: {
		DisplayName: 巡游者圣物
		Tooltip: ""
	}

	DivineRemnants: {
		DisplayName: 神瘟残枝
		Tooltip: 召唤星神少女
	}

	BottleDarkMatter: {
		DisplayName: 瓶装暗物质
		Tooltip: 召唤无尽虚空（更可爱一点）
	}

	DivineIntervention: {
		DisplayName: 神圣干预
		Tooltip:
			'''
			发射一个神圣护盾
			弹反接触到的弹幕
			对击中的敌人造成伤害
			3分钟冷却时间
			'''
	}

	Godhead: {
		DisplayName: 神性
		Tooltip:
			'''
			你的射弹会带有一个光环，对光环内的敌人持续造成伤害
			关闭饰品可见性时无法看见光环，但正常造成伤害
			光环无视无敌帧
			'''
	}

	VoidEcho: {
		DisplayName: 神权象征
		Tooltip:
			'''
			召唤一圈[ceeffect/cruiser:神权炮]
			松开鼠标会同时发射[ceeffect/cruiser:虚空镭射]
			“即便只是虚空的一部分，也拥有湮灭万物的力量”
			'''
	}

	FriendBox: {
		DisplayName: 朋友盒
		Tooltip:
			'''
			召唤一对纠缠双子，复制你的弹幕
			复制弹幕造成原武器100%的伤害
			所有造成的伤害减少为原本的1/5
			每对纠缠双子消耗4个召唤栏
			'''
	}

	LightningPendant: {
		DisplayName: 闪电挂件
		Tooltip: 召唤一位小编织者
	}

	EvilFriend: {
		DisplayName: 邪恶伙伴
		Tooltip: 召唤一个硫磺火宝宝
	}

	TheocracyPearlToy: {
		DisplayName: 神权珍珠
		Tooltip: 召唤虚空武神阿比斯
	}

	CruiserTrophy: {
		DisplayName: 巡游者纪念章
		Tooltip: ""
	}

	VoidMonolith: {
		DisplayName: 虚空石碑
		Tooltip: ""
	}

	VoidToy: {
		DisplayName: 虚空珍珠
		Tooltip: 召唤虚空伙伴
	}

	WingsOfHush: {
